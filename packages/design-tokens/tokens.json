{
  "$meta": {
    "name": "OrenjiTrade design tokens",
    "version": "0.1.0",
    "source": "docs/design/design-system.md",
    "cssPrefix": "",
    "description": "Single source of truth for colours, typography, spacing, radii and breakpoints shared by web (Angular Material M3) and mobile (React Native)."
  },
  "font": {
    "display": {
      "web": "\"Sora\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "mobile": "Sora",
      "use": "wordmark, screen titles, big numbers"
    },
    "body": {
      "web": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "mobile": "Inter",
      "use": "everything else"
    },
    "mono": {
      "web": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
      "mobile": "JetBrains Mono",
      "use": "card codes, set codes, collector numbers, tracking numbers"
    }
  },
  "fontSize": {
    "xs": 12,
    "sm": 14,
    "md": 16,
    "lg": 18,
    "xl": 20,
    "2xl": 24,
    "3xl": 30,
    "4xl": 36
  },
  "lineHeight": {
    "body": 1.5,
    "heading": 1.2
  },
  "fontWeight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 16,
    "pill": 999
  },
  "breakpoint": {
    "xs": 0,
    "sm": 600,
    "md": 960,
    "lg": 1280,
    "xl": 1920
  },
  "focus": {
    "width": 2,
    "offset": 2
  },
  "elevation": {
    "none": "none",
    "floating": "0 4px 16px rgba(28, 25, 23, 0.12), 0 1px 3px rgba(28, 25, 23, 0.08)",
    "sheet": "0 -4px 24px rgba(28, 25, 23, 0.16)",
    "menu": "0 8px 24px rgba(28, 25, 23, 0.16)"
  },
  "motion": {
    "durationFast": "120ms",
    "durationBase": "200ms",
    "durationSlow": "320ms",
    "easingStandard": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "gameTile": {
    "$platforms": ["mobile"],
    "$description": "Monogram tiles of the games (stage G of the phone redesign, mockup v50 screens 34 and 17): a rounded square with the game's letter, the same in both themes. Mobile only: the paused web shows no game tiles.",
    "yugioh": { "letter": "Y", "foreground": "#FDBA74", "background": "#4A2A0A" },
    "pokemon": { "letter": "P", "foreground": "#FDE68A", "background": "#3F3A12" },
    "mtg": { "letter": "M", "foreground": "#BFDBFE", "background": "#1E3A5F" },
    "onepiece": { "letter": "O", "foreground": "#FCA5A5", "background": "#4A1D1D" },
    "riftbound": { "letter": "R", "foreground": "#86EFAC", "background": "#1F3B2A" }
  },
  "color": {
    "light": {
      "primary": "#F4761A",
      "onPrimary": "#FFFFFF",
      "primaryContainer": "#FFE1CB",
      "onPrimaryContainer": "#4A1F00",
      "accent": "#0F766E",
      "onAccent": "#FFFFFF",
      "accentContainer": "#CCF1EC",
      "onAccentContainer": "#053B37",
      "ink": "#1C1917",
      "textMuted": "#57534E",
      "textDisabled": "#A8A29E",
      "background": "#FFFBF7",
      "surface": "#FFFFFF",
      "surfaceVariant": "#F5EFE8",
      "surfaceElevated": "#FFFFFF",
      "border": "#E7E5E4",
      "borderStrong": "#D6D3D1",
      "overlay": "rgba(28, 25, 23, 0.48)",
      "focusRing": "#0F766E",
      "success": "#16A34A",
      "warning": "#D97706",
      "danger": "#DC2626",
      "info": "#2563EB",
      "status": {
        "fresh": "#16A34A",
        "aging": "#D97706",
        "stale": "#E4572E",
        "hidden": "#78716C"
      },
      "availability": {
        "collection": "#78716C",
        "trade": "#0F766E",
        "sale": "#F4761A",
        "tradeOrSale": "linear-gradient(90deg, #0F766E 0%, #F4761A 100%)",
        "offers": "#7C3AED",
        "notAvailable": "#A8A29E"
      },
      "online": {
        "online": "#22C55E",
        "recent": "#F59E0B",
        "offline": "transparent"
      },
      "deckCore": {
        "$platforms": ["mobile"],
        "tagBackground": "#EDE9FE",
        "tagText": "#5B21B6",
        "switch": "#7C3AED",
        "surface": "#FAF7FF",
        "border": "#C4B5FD"
      },
      "chat": {
        "$platforms": ["mobile"],
        "pinnedBar": "#FBF6F0",
        "otherBubble": "#F0E9E1",
        "saleSurface": "#EEFBF8",
        "saleBorder": "#99E2D8",
        "saleText": "#0B3D38",
        "saleTrackingSurface": "#FFFFFF",
        "saleLabel": "#0F766E",
        "saleAction": "#0F766E",
        "soldTagBackground": "#CCF1EC",
        "soldTagText": "#0B3D38"
      },
      "profile": {
        "$platforms": ["mobile"],
        "gameChipBackground": "#FFF1E6",
        "gameChipBorder": "#FDBA74",
        "gameChipText": "#9A3412",
        "tagChipBackground": "#FFFFFF",
        "tagChipBorder": "#E7E5E4",
        "tagChipText": "#44403C"
      }
    },
    "dark": {
      "primary": "#FF8F3D",
      "onPrimary": "#2A1200",
      "primaryContainer": "#6B2E00",
      "onPrimaryContainer": "#FFDCC4",
      "accent": "#2DD4BF",
      "onAccent": "#003733",
      "accentContainer": "#0F5F59",
      "onAccentContainer": "#BFF3ED",
      "ink": "#F5F5F4",
      "textMuted": "#A8A29E",
      "textDisabled": "#57534E",
      "background": "#141210",
      "surface": "#1E1B18",
      "surfaceVariant": "#292522",
      "surfaceElevated": "#2A2623",
      "border": "#292524",
      "borderStrong": "#44403C",
      "overlay": "rgba(0, 0, 0, 0.6)",
      "focusRing": "#2DD4BF",
      "success": "#4ADE80",
      "warning": "#FBBF24",
      "danger": "#F87171",
      "info": "#60A5FA",
      "status": {
        "fresh": "#4ADE80",
        "aging": "#FBBF24",
        "stale": "#FB7A4F",
        "hidden": "#A8A29E"
      },
      "availability": {
        "collection": "#A8A29E",
        "trade": "#2DD4BF",
        "sale": "#FF8F3D",
        "tradeOrSale": "linear-gradient(90deg, #2DD4BF 0%, #FF8F3D 100%)",
        "offers": "#A78BFA",
        "notAvailable": "#78716C"
      },
      "online": {
        "online": "#4ADE80",
        "recent": "#FBBF24",
        "offline": "transparent"
      },
      "deckCore": {
        "$platforms": ["mobile"],
        "tagBackground": "#2E2547",
        "tagText": "#C4B5FD",
        "switch": "#8B5CF6",
        "surface": "#1A1720",
        "border": "#4C3D74"
      },
      "chat": {
        "$platforms": ["mobile"],
        "pinnedBar": "#1A1715",
        "otherBubble": "#2A2522",
        "saleSurface": "#10211F",
        "saleBorder": "#1F4D47",
        "saleText": "#CCFBF1",
        "saleTrackingSurface": "#0B1716",
        "saleLabel": "#99F6E4",
        "saleAction": "#5EEAD4",
        "soldTagBackground": "#0F3D39",
        "soldTagText": "#5EEAD4"
      },
      "profile": {
        "$platforms": ["mobile"],
        "gameChipBackground": "#2A1A0D",
        "gameChipBorder": "#5C3418",
        "gameChipText": "#FDBA74",
        "tagChipBackground": "#1E1B18",
        "tagChipBorder": "#2E2A26",
        "tagChipText": "#D6D3D1"
      }
    }
  }
}
