# OrenjiTrade ML service. Copy to `.env` (git-ignored) or export as environment variables.
# Every value is a placeholder; the service runs locally with these defaults.

# HTTP port (Cloud Run injects PORT automatically).
PORT=8000
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# stub  -> deterministic fixture-backed identifier (default, used by CI)
# torch -> real model backend (not implemented yet: /ready reports 503 and results degrade)
MODEL_BACKEND=stub
# Reported in every response and CardScanCompleted event.
MODEL_VERSION=stub-0.1.0

# OrenjiTrade API that receives CardScanCompleted results (POST {API_BASE_URL}/internal/ml/scan-results).
API_BASE_URL=http://localhost:8080
# Optional shared secret. When set: required as X-Service-Token on /internal/* requests and
# sent as X-Service-Token when posting results to the API. Leave empty locally.
SERVICE_AUTH_TOKEN=

# Upload / fetch limits.
MAX_IMAGE_BYTES=8388608
MAX_IMAGE_SIDE_PX=8192
# Optional comma-separated allow-list for imageUrl / imageUri hosts (empty = any host).
IMAGE_URL_ALLOWED_HOSTS=
IMAGE_FETCH_TIMEOUT_SECONDS=5
API_TIMEOUT_SECONDS=5

# Hamming distance (0-64) at or below which two dHashes count as duplicates.
DUPLICATE_THRESHOLD=10
