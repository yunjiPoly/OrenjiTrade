# ---------------------------------------------------------------------------
# OrenjiTrade environment template. Copy to `.env` (git-ignored) and fill in.
# Every value here is a placeholder. Never commit real credentials.
# Local development works with the defaults below (docs/development/local-setup.md).
# `.env` is read by docker compose (port variables) and by the npm scripts
# (npm run dev / api:dev / test:e2e pass non-empty values to the API and web;
# variables already set in your shell win). Empty values mean "use the default".
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
# local | development | staging | production
ORENJI_ENV=local
SPRING_PROFILES_ACTIVE=local
# API HTTP port (Cloud Run injects PORT instead)
SERVER_PORT=8080

# --- docker compose host ports (docker-compose.yml) --------------------------
# Change only when a port is taken on your machine, and adjust the matching
# URL below (DATABASE_URL, REDIS_URL, FIREBASE_AUTH_EMULATOR_HOST).
POSTGRES_PORT=5432
REDIS_PORT=6379
FIREBASE_AUTH_PORT=9099
FIREBASE_UI_PORT=4000
PUBSUB_PORT=8085
# Host ports of the optional all-in-Docker stack: docker compose --profile app up -d --build
API_PORT=8080
WEB_PORT=4200

# --- Database (PostgreSQL + PostGIS) ---------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/orenjitrade
DATABASE_USERNAME=orenjitrade
DATABASE_PASSWORD=orenjitrade_local
# Cloud SQL (Cloud Run): use the connector socket path instead of host/port
# DATABASE_URL=jdbc:postgresql:///orenjitrade?cloudSqlInstance=PROJECT:REGION:INSTANCE&socketFactory=com.google.cloud.sql.postgres.SocketFactory

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Identity (Firebase Authentication / Identity Platform) -----------------
FIREBASE_PROJECT_ID=orenjitrade-local
# Local only: point the Admin SDK and web/mobile SDKs at the emulator.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Production: Application Default Credentials on Cloud Run; no key file needed.
# GOOGLE_APPLICATION_CREDENTIALS=

# Public web/mobile Firebase config (safe to expose, restricted by domain in Firebase console)
FIREBASE_WEB_API_KEY=demo-local-key
FIREBASE_WEB_AUTH_DOMAIN=orenjitrade-local.firebaseapp.com
FIREBASE_WEB_APP_ID=

# --- Google Cloud ----------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=northamerica-northeast1
GCS_BUCKET_MEDIA=
# local | gcs
STORAGE_PROVIDER=local
# Relative to the API working directory (apps/api when started by the npm scripts)
STORAGE_LOCAL_ROOT=./.local-storage
# Origin of public media URLs. Empty: served by the API itself (/api/v1/public/media/{key})
STORAGE_PUBLIC_BASE_URL=

# --- Card images and catalog providers (ADR 0015, docs/providers/ygoprodeck.md) -----
# Local card image cache: never more than this many MiB (maximum 5120 = 5 GB, enough for the whole
# Yu-Gi-Oh! catalog at 320 px; larger values stop the start-up; smaller values are allowed).
# Empty: 5120.
CARD_IMAGE_LOCAL_CACHE_MAX_MB=5120
# Cache directory (one per database). Empty: <STORAGE_LOCAL_ROOT>/card-images
CARD_IMAGE_CACHE_DIR=
# Where the renditions live: empty follows STORAGE_PROVIDER (local: files under the cache
# directory; gcs: objects under CARD_IMAGE_OBJECT_PREFIX of GCS_BUCKET_MEDIA, or of
# CARD_IMAGE_GCS_BUCKET). Temporary downloads always stay in the cache directory.
CARD_IMAGE_STORAGE_PROVIDER=
CARD_IMAGE_GCS_BUCKET=
CARD_IMAGE_OBJECT_PREFIX=card-images/
# GET /api/v1/public/card-images/{id} may download a missing artwork while capacity remains
CARD_IMAGE_ON_DEMAND_ENABLED=true
# Card image requests per minute and IP (cached artworks and placeholders)
RATE_LIMIT_CARD_IMAGES_PER_MINUTE=600
# Real Yu-Gi-Oh! catalog from YGOPRODeck (imported only with npm run catalog:import or the admin
# sync). Requests per second per host (provider limit 20; refused above 15).
YGOPRODECK_ENABLED=true
YGOPRODECK_REQUESTS_PER_SECOND=5
# true: never call the API, import the newest local snapshot (offline work)
YGOPRODECK_SNAPSHOT_ONLY=false
# Raw provider JSON snapshots, relative to the API working directory (git-ignored)
PROVIDER_DATA_DIR=./.local-dev/provider-data
# Base URL of the API for the local scripts (catalog:import, card-images:*). Empty: http://localhost:8080
ORENJI_API_URL=

# --- Events / messaging ----------------------------------------------------
# local (in-process, transactional outbox) | pubsub
EVENTS_TRANSPORT=local
PUBSUB_EMULATOR_HOST=
PUBSUB_TOPIC_DOMAIN_EVENTS=domain-events
PUBSUB_TOPIC_ANALYTICS=analytics-events

# --- Payments (feature-flagged; FakePaymentProvider when empty) -------------
# fake | stripe
PAYMENT_PROVIDER=fake
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
# HMAC key of the fake provider's synthetic webhooks (not a real secret; local only)
FAKE_PAYMENTS_WEBHOOK_SECRET=local-fake-payments-webhook-secret
# Empty: fake checkout pages are the web paths /checkout/fake/<ref>, /checkout/fake-billing/<ref>, ...
FAKE_CHECKOUT_BASE_URL=
# Web origin used in Stripe return URLs (stripe providers only)
WEB_BASE_URL=

# --- Subscriptions, donations, ads (Phase 10) -------------------------------
# fake | stripe
BILLING_PROVIDER=fake
FAKE_BILLING_WEBHOOK_SECRET=local-fake-billing-webhook-secret
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
# fake only
DONATION_PROVIDER=fake
FAKE_DONATIONS_WEBHOOK_SECRET=local-fake-donations-webhook-secret
# HMAC key of ad serve tokens; the default is refused outside local/test/dev
ADS_TOKEN_SECRET=local-ads-token-secret
# Origin of relative house-ad landing paths on click redirects
ADS_WEB_BASE_URL=http://localhost:4200

# --- Push notifications ----------------------------------------------------
# log | fcm
PUSH_PROVIDER=log
FCM_PROJECT_ID=

# --- Email -----------------------------------------------------------------
# log | sendgrid | ses
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@orenjitrade.com

# --- ML service (Phase 11 on hold; nothing calls it locally) ------------------
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=1500

# --- Cloudflare (documentation / IaC only) ---------------------------------
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Web (Angular) -----------------------------------------------------------
WEB_API_BASE_URL=http://localhost:8080
WEB_WS_BASE_URL=ws://localhost:8080/ws

# --- Mobile (Expo) ------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_FIREBASE_API_KEY=demo-local-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=orenjitrade-local.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=orenjitrade-local
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- Security ----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081,http://localhost:19006
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
# Shared secret for /internal/** (Cloud Scheduler / ML callbacks). Local default is fine;
# staging/prod MUST set a random value (startup fails on the default).
SERVICE_TOKEN=local-service-token
# Google OIDC alternative for /internal/**: expected audience + allowed invoker emails (comma list)
INTERNAL_AUDIENCE=
INTERNAL_INVOKERS=
# Salt for hashing IPs stored with legal consents (never store raw IPs)
CONSENT_IP_SALT=local-consent-salt
# HMAC key pseudonymising account ids in analytics events (actor_hash). Required outside local/test.
ANALYTICS_ACTOR_SALT=local-analytics-salt
# Password given to the seeded Firebase emulator accounts (local/dev only)
SEED_EMULATOR_PASSWORD=LocalDev!2026
DATABASE_POOL_SIZE=10

# --- Local scripts -------------------------------------------------------------
# JDK the E2E harnesses and the purge use to run the API jar (`npm run test:e2e`,
# `test:mobile:e2e`, `test:mobile:maestro`, `e2e:purge`): a JDK 21, like CI and production.
# Empty: JAVA_HOME when it is Java 21+, else a Java 21 found on PATH, through
# /usr/libexec/java_home (macOS) or under ~/.gradle/jdks. A newer Java is only the last
# resort and is reported in the log. The scripts read it from this file or from the shell;
# an exported ORENJI_JAVA_HOME wins over this entry.
ORENJI_JAVA_HOME=
