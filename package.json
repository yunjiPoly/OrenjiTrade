{
  "name": "orenjitrade",
  "version": "0.1.0",
  "private": true,
  "description": "OrenjiTrade monorepo root: one npm workspace for the Angular web app, the Expo mobile app and the shared packages. apps/api (Gradle) and apps/ml (pip) are not npm packages.",
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/web-angular",
    "apps/mobile",
    "packages/design-tokens",
    "packages/api-client",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "api:dev": "node scripts/api-dev.mjs",
    "web:dev": "npm run start -w apps/web-angular",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:reset": "node scripts/infra.mjs reset",
    "infra:validate": "node scripts/infra-validate.mjs",
    "test:api": "node scripts/test.mjs api",
    "test:web": "node scripts/test.mjs web",
    "test:mobile": "node scripts/test.mjs mobile",
    "test:e2e": "node scripts/test.mjs e2e",
    "test:scripts": "node scripts/test.mjs scripts",
    "e2e:purge": "node scripts/e2e-purge.mjs",
    "test:all": "node scripts/test.mjs all",
    "test:ml": "node scripts/test.mjs ml",
    "build:tokens": "npm run build -w packages/design-tokens",
    "generate:api": "npm run generate -w packages/api-client && npm run generate -w packages/shared-types",
    "catalog:import": "node scripts/catalog-import.mjs",
    "card-images:status": "node scripts/card-images.mjs status",
    "card-images:clear": "node scripts/card-images.mjs clear",
    "card-images:reconcile": "node scripts/card-images.mjs reconcile",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "audit:gate": "node scripts/audit-gate.mjs"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
