# ---------------------------------------------------------------------------
# OrenjiTrade mobile (Expo) environment template. Copy to `.env` (git-ignored)
# only when you need to override a default. Every `EXPO_PUBLIC_*` value is
# inlined into the JS bundle: PUBLIC values only, never secrets.
#
# Without a .env the app targets the local stack (`npm run infra:up` + the API
# on :8080) and picks the host per platform (src/config/env.ts):
#   Android emulator -> 10.0.2.2 (the development machine)
#   iOS simulator, web -> localhost
# A physical device needs your machine's LAN address instead.
# ---------------------------------------------------------------------------

# Base URL of the OrenjiTrade API (no trailing slash). Default: http://<host>:8080.
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Firebase web config (public). Defaults: the local project used with the Auth emulator.
# EXPO_PUBLIC_FIREBASE_API_KEY=demo-local-key
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=orenjitrade-local.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=orenjitrade-local
# EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase Auth emulator `host:port`. Default for the local project: <host>:9099.
# Set to `off` to talk to a real Firebase project.
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=10.0.2.2:9099

# Google Maps Android key (app-restricted, public), used by a development or
# store build only. Empty (and always in Expo Go, whose bundled key Google
# refuses) => Android maps use Leaflet + OpenStreetMap in a WebView, like the
# web app's fallback; iOS uses Apple Maps and needs no key.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
