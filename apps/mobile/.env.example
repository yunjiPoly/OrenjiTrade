# ---------------------------------------------------------------------------
# OrenjiTrade mobile (Expo) environment template. Copy to `.env` (git-ignored).
# Every `EXPO_PUBLIC_*` value is inlined into the JS bundle: PUBLIC values only.
# Never put secrets here. Defaults below work with `docker compose up -d` at
# the repository root and the Spring Boot API on http://localhost:8080.
# ---------------------------------------------------------------------------

# Base URL of the OrenjiTrade API (no trailing slash). Use your machine's LAN IP
# (e.g. http://192.168.1.20:8080) when testing on a physical device with Expo Go.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Firebase web config (public, domain-restricted in the Firebase console).
EXPO_PUBLIC_FIREBASE_API_KEY=demo-local-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=orenjitrade-local.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=orenjitrade-local
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local only: point the Firebase Auth SDK at the emulator started by docker compose.
# Leave empty to talk to the real Firebase project.
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Google Maps Android key (app-restricted). Empty => Android map renders without tiles,
# iOS uses Apple Maps and needs no key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
