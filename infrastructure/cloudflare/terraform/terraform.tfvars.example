# Copy to terraform.tfvars (git-ignored). Every value here is fictional.
# Export CLOUDFLARE_API_TOKEN in the shell instead of setting cloudflare_api_token here.

zone_id   = "0123456789abcdef0123456789abcdef"
zone_name = "orenjitrade.com"

# terraform -chdir=../../terraform/environments/prod output -raw load_balancer_ipv4
load_balancer_ipv4 = "203.0.113.10"
# load_balancer_ipv6 = "2001:db8::10"

# Certificate Manager DNS authorization (DNS only, never proxied):
# terraform -chdir=../../terraform/environments/prod output -json certificate_dns_authorizations
certificate_dns_authorizations = {
  "www.orenjitrade.com" = {
    name = "_acme-challenge.www.orenjitrade.com."
    type = "CNAME"
    data = "0123abcd-0000-4000-8000-0123456789ab.1.authorize.certificatemanager.goog."
  }
  "api.orenjitrade.com" = {
    name = "_acme-challenge.api.orenjitrade.com."
    type = "CNAME"
    data = "4567efab-0000-4000-8000-0123456789cd.1.authorize.certificatemanager.goog."
  }
}

# Non-production origins (outputs of environments/dev and environments/staging), only while
# those environments exist (staging is created on demand).
additional_a_records = {
  "dev"     = "203.0.113.20"
  "dev-api" = "203.0.113.20"
}

# Replace the placeholders once the transactional email provider is chosen.
email_records = {
  "@" = {
    type    = "TXT"
    content = "v=spf1 include:_spf.example-mail-provider.com -all"
  }
  "_dmarc" = {
    type    = "TXT"
    content = "v=DMARC1; p=quarantine; rua=mailto:dmarc-reports@example.com; adkim=s; aspf=s"
  }
  "mail._domainkey" = {
    type    = "CNAME"
    content = "mail.dkim.example-mail-provider.com"
  }
}

security_level               = "medium"
bot_fight_mode               = true
enable_managed_waf           = false # true on Pro or higher
block_internal_paths_at_edge = false # true once operator scripts stop using the public hostname
hsts_max_age                 = 31536000
hsts_preload                 = false

# Free plan: one rule, 10 s window, per IP (+ data centre). Path prefixes in variables.tf.
rate_limit_requests_per_10s = 60
