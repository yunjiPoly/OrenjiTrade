# Copy to terraform.tfvars (git-ignored) and fill in. Every value here is fictional.
# Staging is NOT provisioned by default: bring it up for a release check and destroy it
# afterwards (infrastructure/terraform/README.md, "Temporary staging").

project_id        = "orenjitrade-staging-123456"
region            = "northamerica-northeast1"
github_repository = "example-org/orenjitrade"
alert_email       = "staging-alerts@example.com"

web_host = "staging.orenjitrade.com"
api_host = "staging-api.orenjitrade.com"

# Public web configuration (Firebase web app of the staging project; no secrets).
firebase_web_api_key    = "AIzaSyExampleExampleExampleExampleExampl"
firebase_web_app_id     = "1:123456789012:web:0123456789abcdef012345"
google_maps_browser_key = ""
google_maps_map_id      = ""

# Stripe test keys only after the secret versions exist.
stripe_secrets_enabled = false

restrict_to_cloudflare = true
certificate_mode       = "certificate_manager"
deletion_protection    = false # the environment is created and destroyed on demand
storage_force_destroy  = true

labels = {
  cost_center = "orenjitrade"
}
