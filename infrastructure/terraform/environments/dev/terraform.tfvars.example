# Copy to terraform.tfvars (git-ignored) and fill in. Every value here is fictional.
# Sizing defaults for dev (smallest low-cost topology, ADR 0016) live in variables.tf.

project_id        = "orenjitrade-dev-123456"
region            = "northamerica-northeast1"
github_repository = "example-org/orenjitrade"
alert_email       = "dev-alerts@example.com"

web_host = "dev.orenjitrade.com"
api_host = "dev-api.orenjitrade.com"

# Public web configuration (Firebase web app of the dev project; no secrets).
firebase_web_api_key    = "AIzaSyExampleExampleExampleExampleExampl"
firebase_web_app_id     = "1:123456789012:web:0123456789abcdef012345"
google_maps_browser_key = ""
google_maps_map_id      = ""

# Staging/prod Cloud Run service agents pull the images built into this project's registry.
# artifact_registry_reader_members = [
#   "serviceAccount:service-<STAGING_PROJECT_NUMBER>@serverless-robot-prod.iam.gserviceaccount.com",
#   "serviceAccount:service-<PROD_PROJECT_NUMBER>@serverless-robot-prod.iam.gserviceaccount.com",
# ]

stripe_secrets_enabled = false
restrict_to_cloudflare = false
certificate_mode       = "certificate_manager"
deletion_protection    = false

labels = {
  cost_center = "orenjitrade"
}
