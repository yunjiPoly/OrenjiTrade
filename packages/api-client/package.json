{
  "name": "@orenji/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Generated Angular HttpClient services and models for the OrenjiTrade API (source: docs/api/openapi.json). Consumed as TypeScript source by apps/web-angular.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "npm install --prefix tools --no-audit --no-fund && npm run generate --prefix tools",
    "clean": "node -e \"require('node:fs').rmSync('src', { recursive: true, force: true })\""
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "tslib": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
