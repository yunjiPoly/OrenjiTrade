{
  "name": "@orenji/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "OrenjiTrade API types generated from docs/api/openapi.json plus a typed openapi-fetch client factory (consumed by apps/mobile).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../docs/api/openapi.json -o ./src/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run generate && npm run typecheck"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
